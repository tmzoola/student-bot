# ─── App ─────────────────────────────────────────────────────────────
# Production'da DEBUG=False.
DEBUG=True
# REQUIRED — session/cookie signing uchun. Generatsiya: `openssl rand -hex 32`.
SECRET_KEY=

# ─── Database (PostgreSQL) ───────────────────────────────────────────
# Docker Compose'da POSTGRES_HOST konteyner ichida `db` ga override qilinadi
# (compose.yml environment bo'limida). Lokal ishlashda `localhost` qoladi.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# REQUIRED — kuchli parolga o'zgartiring.
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos
POSTGRES_DB=student

# ─── Admin panel (starlette-admin) ───────────────────────────────────
# REQUIRED — production uchun kuchli parol qo'ying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ─── CORS ────────────────────────────────────────────────────────────
# Bo'sh joy bilan ajratilgan originlar. Production'da WEBAPP_URL bilan bir xil.
CORS_ALLOWED_ORIGINS=https://student-13-140-165-210.sslip.io

# ─── Telegram bot ────────────────────────────────────────────────────
# REQUIRED — @BotFather'dan olingan token.
BOT_TOKEN=
# REQUIRED — bot username (@ belgisisiz). Deep-link uchun ishlatiladi:
# https://t.me/<BOT_USERNAME>?start=...
BOT_USERNAME=
# REQUIRED — WebApp uchun public HTTPS URL. Telegram HTTPS talab qiladi.
WEBAPP_URL=https://student-13-140-165-210.sslip.io
# REQUIRED — yangi talabaning ro'yxatdan o'tish arizasi shu chatga boradi.
# Shaxsiy admin uchun @userinfobot orqali chat_id oling. Guruh bo'lsa `-100...`.
# Agar 0 bo'lsa notify o'tkazib yuboriladi (warn log qoladi).
ADMIN_CHAT_ID=0

# ─── Redis (kesh + FSM state) ────────────────────────────────────────
# Docker Compose ichidagi `redis` xizmatiga ishora qiladi.
REDIS_URL=redis://redis:6379/0

# ─── Grafana (log dashboard) ─────────────────────────────────────────
# REQUIRED (production) — kuchli parol qo'ying. Diqqat: Grafana volume
# mavjud bo'lsa bu qiymat faqat birinchi ishga tushganda qo'llanadi;
# keyingi safar `docker exec ... grafana cli admin reset-admin-password ...`.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# ─── AI (Bosqich 5 — material → test) ────────────────────────────────
# Talaba material yuklaydi → AI 10 ta MCQ savol yaratadi.
# Qiymat: "claude" (hozircha faqat shu).
AI_PROVIDER=claude
# REQUIRED (Bosqich 5) — https://console.anthropic.com dan olingan API kalit.
ANTHROPIC_API_KEY=
# Latest Sonnet.
AI_MODEL=claude-sonnet-4-6
# Har bir talaba uchun kunlik test-generatsiya limiti.
AI_DAILY_LIMIT_PER_USER=20

# ─── Universitet konteksti ───────────────────────────────────────────
# Bitta universitet uchun sozlangan (hozircha SaaS emas).
UNIVERSITY_NAME=
UNIVERSITY_SHORT_NAME=
