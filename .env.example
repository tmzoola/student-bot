# App
DEBUG=True
SECRET_KEY=

# Database (Docker: host=db / local: host=localhost)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos
POSTGRES_DB=student

# Admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS (space-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:8000

# Telegram bot (get token from @BotFather)
BOT_TOKEN=
# Bot username (without @). Deep-link linklar shu asosda quriladi:
# https://t.me/<BOT_USERNAME>?start=ref_<inviter_id>
BOT_USERNAME=
# Public HTTPS URL where this server is reachable (required for Telegram WebApp)
WEBAPP_URL=https://your-domain.com

# Multi-worker umumiy kesh (Docker Compose ichidagi `redis` xizmatiga ishora qiladi).
REDIS_URL=redis://redis:6379/0

# Grafana admin (log dashboard)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# ─── AI analiz provideri ─────────────────────────────────────────────
# Talabaning zaif/kuchli tomonlarini AI orqali baholash uchun.
# Qiymat: "claude" yoki "openai".
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Universitet konteksti ───────────────────────────────────────────
# Bitta universitet uchun sozlangan (hozircha SaaS emas).
UNIVERSITY_NAME=
UNIVERSITY_SHORT_NAME=
